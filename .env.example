# ==========================================
# Video-Agent Configuration — DEPLOYMENT CHỐT: Cloud-First GPU (Serverless)
# - Video render DUY NHẤT trên cloud (Kling/Wan2.1/HF Inference/Fal.ai),
#   serverless GPU burst pay-per-second, VRAM 24-80GB class.
# - Local (Ollama qwen2.5:3b) CHỈ viết kịch bản text — KHÔNG render video local.
# - Training = Zero Training (chỉ API test, xem colab/hf_inference_demo.ipynb).
# - Test offline $0: LLM_PROVIDER=mock + MOCK_VIDEO/MOCK_TTS=true (Mock provider).
# ==========================================

# LLM ModelRouter (Cloud-First): ollama (local text-only qwen2.5:3b ~2GB, default) | mock (CI $0 offline) | hf-cloud (Qwen-72B cloud, HF Inference serverless)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Giới hạn RAM M1 Pro 16GB: 1 request song song, 1 model trong RAM, unload sau 5m idle.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m

# Hugging Face (optional cloud-only): Qwen-72B scriptwriter + FLUX image (giữ FLUX cloud-only)
HF_TOKEN=your_hugging_face_token_here

# Hugging Face Models (optional cloud only, cấm model >4GB local)
HF_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# Optional Trial Credit Providers (for high-speed portfolio rendering)
FAL_KEY=
REPLICATE_API_TOKEN=

# VIDEO_PROVIDER (Cloud-First, serverless GPU burst pay-per-second, VRAM 24-80GB):
# mock (default, $0 offline CI) | kling/cloud (Kling/Wan2.1 REST, mock-mode khi thiếu key) | hf (HF Inference serverless) | private_gpu
VIDEO_PROVIDER=mock
# MOCK $0 offline: MOCK_VIDEO=true ép mọi video provider về deterministic mock (không đốt API budget)
MOCK_VIDEO=true
MOCK_TTS=true

# Server & Storage
PORT=8000
DATABASE_URL=sqlite:///./data/video_agent.db

# API access and browser origins. Development may use CORS_ORIGINS=* only when
# credentials are disabled. Production requires an API key and explicit origins.
# APP_ENV=staging|production makes the service FAIL-CLOSED: with an empty
# API_KEY every protected route answers 503 instead of being open, and
# production additionally refuses to start without API_KEY/CORS_ORIGINS.
# development is the only environment that stays open with an empty API_KEY.
APP_ENV=development
API_KEY=
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# ==========================================
# Webhook delivery safety (plan Task 4)
# ==========================================
# Per-target or global HMAC secret. PRODUCTION REQUIRES a real secret —
# the dev-secret fallback only exists in explicit development mode.
WEBHOOK_SECRET=
# Comma-separated allowlist of webhook hostnames. Anything not allowlisted
# is DNS-resolved and rejected if it maps to loopback/RFC1918/link-local IPs.
WEBHOOK_ALLOWED_HOSTS=

# ==========================================
# Async render worker (plan Task 3)
# ==========================================
# Remotion subprocess budget per render job (worker-side, never in-request).
RENDER_TIMEOUT_SEC=600

# ==========================================
# WP4 Stateless Free-Infra ($0 free-tier)
# ==========================================
# Storage backend: local | s3mock | r2 (R2-compat S3 endpoint)
STORAGE_BACKEND=local
# Local disk root cho artifact (renders/manifests) khi STORAGE_BACKEND=local
OUT_DIR=./out
# R2 / S3-compatible endpoint (Cloudflare R2 free-tier 10GB)
R2_ENDPOINT=
# Ledger DB: default sqlite local; prod trỏ free-tier postgres (Neon/Supabase)
# DATABASE_URL=sqlite:///./data/video_agent.db
