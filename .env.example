# ==========================================
# Video-Agent Configuration
# ==========================================

# Execution Mode: Set to true for zero-cost offline development and testing
MOCK_VIDEO=true
MOCK_TTS=true

# Google Gemini API Key (optional, used when MOCK_VIDEO=false)
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API Key (optional, used when MOCK_TTS=false and provider=elevenlabs)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Budget Guardrails (USD)
MAX_COST_PER_PROJECT=10.0
MAX_COST_PER_GENERATION=2.5

# Server & Storage
PORT=8000
DATABASE_URL=sqlite:///./data/video_agent.db
